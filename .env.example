# Skopíruj do .env (Copy-Item .env.example .env). .env je mimo gitu; skutočné tajomstvá patria len tam.

POSTGRES_USER=servisnik
POSTGRES_PASSWORD=servisnik
POSTGRES_DB=servisnik
POSTGRES_PORT=5432
DATABASE_URL=postgres://servisnik:servisnik@localhost:5432/servisnik
# PEM certifikátu CA, ktorá podpísala certifikát databázy (DigitalOcean má vlastnú; na DO ho doplní App Spec). Lokálne nechaj prázdne.
DATABASE_CA_CERT=

# MinIO (S3 API); konzola na http://localhost:9001 s rovnakými prístupmi.
S3_ACCESS_KEY_ID=servisnik
S3_SECRET_ACCESS_KEY=servisnik-secret
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000

# Lokálny port, na ktorý quick tunnel posiela webhooky KROS (Next.js dev server).
TUNNEL_TARGET=http://host.docker.internal:3000

# Appka (apps/web). BETTER_AUTH_SECRET podpisuje relácie: vygeneruj si ho (návod v README), nezdieľaj ho a nedávaj do gitu.
BETTER_AUTH_SECRET=
# Adresa, na ktorej appka beží; na https určuje, že cookie relácie je Secure.
BETTER_AUTH_URL=http://localhost:3000

# Prvý admin. `pnpm db:seed` ho založí alebo mu nastaví toto heslo; registrácia v appke nie je.
ADMIN_EMAIL=
ADMIN_PASSWORD=
