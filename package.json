{
  "name": "servisnik",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc && pnpm --filter @servisnik/web typecheck",
    "test": "vitest run",
    "check-commits": "node packages/check-commits/src/cli.ts",
    "verify": "pnpm typecheck && pnpm check-commits && pnpm test",
    "smoke": "node tools/smoke.ts",
    "dev": "pnpm --filter @servisnik/web dev",
    "db:migrate": "pnpm --filter @servisnik/web db:migrate",
    "db:seed": "pnpm --filter @servisnik/web db:seed",
    "e2e": "pnpm --filter @servisnik/web e2e",
    "e2e:install": "pnpm --filter @servisnik/web exec playwright install chromium",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose --profile tunnel down",
    "tunnel": "docker compose --profile tunnel up tunnel"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
