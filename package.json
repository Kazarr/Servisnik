{
  "name": "servisnik",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose --profile tunnel down",
    "tunnel": "docker compose --profile tunnel up tunnel"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
