{
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "Bash(gh issue close *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/cpu-gate.ts\"",
            "timeout": 30,
            "statusMessage": "CPU gate: may another implementer start?"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/edit-tier.sh\"",
            "timeout": 60,
            "statusMessage": "Edit tier: pnpm typecheck"
          }
        ]
      }
    ]
  }
}
